# Copiar a .env.personal (o .env) y completar. Nunca commitear el archivo real.

# discover — Google Places API (New)
GOOGLE_PLACES_API_KEY=

# score — PageSpeed Insights. Opcional: sin key hay cuota reducida.
PAGESPEED_API_KEY=

# score — Chrome UX Report (datos de campo reales). Opcional: si falta, cae a
# PAGESPEED_API_KEY (mismo proyecto de Google Cloud habilita las dos APIs).
# Habilitar "Chrome UX Report API" en el mismo proyecto de Google Cloud Console.
CRUX_API_KEY=

# generate, outreach — remitente
GTM_FROM_NAME="Tu Nombre"

# outreach — obligatorias por CAN-SPAM
GTM_FROM_EMAIL=tu@email.com
GTM_PHYSICAL_ADDRESS="Calle 123, Ciudad, País"
GTM_UNSUBSCRIBE_URL=https://tusitio.com/unsubscribe

# deploy, UI — base pública donde se sirven las demos (también arma el link
# de redirección con tracking, /v/{token}, que se manda en vez de la URL directa)
GTM_DEMO_BASE_URL=https://demos.tusitio.com

# send — casilla propia para envío real por SMTP. Un ESP (Resend/SendGrid/
# Postmark/SES) NO sirve acá: los cinco evaluados prohíben outreach en frío en
# sus propios términos (ver docs/CHANNELS.md). Zoho Mail Lite (~USD 1/mes) es
# la opción evaluada — SMTP/IMAP quedan detrás de un plan pago desde 2025.
# Usar un DOMINIO DISTINTO al del portfolio: si el envío en frío daña la
# reputación de un dominio, que no sea el de tu carta de presentación.
GTM_SMTP_HOST=smtp.zoho.com
GTM_SMTP_PORT=465
GTM_SMTP_USER=bounces@tu-dominio-de-envio.com
GTM_SMTP_PASSWORD=
# Misma casilla que arriba, normalmente: recibe los rebotes (VERP) y
# gtm/send/bounces.py la lee por IMAP para detectarlos.
GTM_BOUNCE_ADDRESS=bounces@tu-dominio-de-envio.com

# UI, backfill — Postgres/Supabase para el store analítico (dashboards).
# Opcional: sin esto la UI funciona igual, todo lo que no se pudo escribir
# queda en gtm/build/outbox.jsonl y se reintenta con `python -m gtm.store.backfill`.
# Formato: postgresql://usuario:password@host:puerto/postgres
# El proyecto de Supabase se crea gratis en supabase.com; el connection string
# está en Project Settings → Database → Connection string (usar el modo
# "Transaction" del pooler, puerto 6543, para no agotar conexiones).
SUPABASE_DB_URL=
