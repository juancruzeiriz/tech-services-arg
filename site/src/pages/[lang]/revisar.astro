---
// Solo genera /es/revisar/ -- la versión en inglés vive en [lang]/check.astro
// bajo un slug distinto (ver routes en src/i18n/utils.ts).
import AuditPageContent from "../../components/AuditPageContent.astro";
import Base from "../../layouts/Base.astro";
import { useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }];
}

const t = useTranslations("es");
---
<Base title={t("audit.title")} description={t("audit.lead")}>
  <AuditPageContent />
</Base>
