---
// Solo genera /en/check/ -- la versión en español vive en [lang]/revisar.astro
// bajo un slug distinto (ver routes en src/i18n/utils.ts).
import AuditPageContent from "../../components/AuditPageContent.astro";
import Base from "../../layouts/Base.astro";
import { useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }];
}

const t = useTranslations("en");
---
<Base title={t("audit.title")} description={t("audit.lead")}>
  <AuditPageContent />
</Base>
