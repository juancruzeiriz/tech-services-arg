---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section class="section cv-section no-print" id="cv">
  <div class="section-inner cv-inner" data-reveal>
    <div>
      <h2>{t("cv.title")}</h2>
      <p class="section-lead">{t("cv.lead")}</p>
    </div>
    <div class="cv-actions">
      <a class="btn btn-ghost" href="/cv/juan-cruz-eiriz-es.pdf" download data-magnetic>{t("cv.downloadEs")}</a>
      <a class="btn btn-ghost" href="/cv/juan-cruz-eiriz-en.pdf" download data-magnetic>{t("cv.downloadEn")}</a>
    </div>
  </div>
</section>

<style>
  .cv-section { border-top: 1px solid var(--border); }
  .cv-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
