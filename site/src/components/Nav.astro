---
import LangSwitch from "./LangSwitch.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { href: "#work", label: t("nav.work") },
  { href: "#about", label: t("nav.about") },
  { href: "#certs", label: t("nav.certs") },
  { href: "#contact", label: t("nav.contact") },
];
---
<header class="nav" data-nav>
  <nav class="nav-inner">
    <a class="nav-brand" href={`/${lang}/`} data-magnetic>JCE</a>

    <ul class="nav-links">
      {links.map((link) => (
        <li><a href={link.href} data-magnetic>{link.label}</a></li>
      ))}
    </ul>

    <div class="nav-actions">
      <LangSwitch />
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    padding: 0.9rem clamp(1.25rem, 4vw, 3rem);
    transition: transform 0.4s var(--ease-out-expo), background-color 0.3s ease, border-color 0.3s ease;
    border-bottom: 1px solid transparent;
  }
  .nav[data-scrolled="true"] {
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: var(--border);
  }
  .nav[data-hidden="true"] { transform: translateY(-100%); }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: 84rem;
    margin-inline: auto;
  }

  .nav-brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: none;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-links a {
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--fg-muted);
    transition: color 0.2s ease;
  }
  .nav-links a:hover { color: var(--fg); }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  @media (min-width: 860px) {
    .nav-links { display: flex; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  if (nav && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      nav.dataset.scrolled = String(y > 8);
      // Solo esconder al bajar pasado el propio alto del nav, y siempre
      // mostrar de nuevo al subir — evita el parpadeo típico cerca del tope.
      if (y > lastY && y > nav.offsetHeight) {
        nav.dataset.hidden = "true";
      } else {
        nav.dataset.hidden = "false";
      }
      lastY = y;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
  } else if (nav) {
    nav.dataset.scrolled = String(window.scrollY > 8);
  }
</script>
