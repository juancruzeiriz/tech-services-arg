---
import LangSwitch from "./LangSwitch.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { href: "#services", label: t("nav.services") },
  { href: "#work", label: t("nav.work") },
  { href: "#about", label: t("nav.about") },
  { href: "#certs", label: t("nav.certs") },
  { href: "#contact", label: t("nav.contact") },
];
// Absolutos, no solo "#work": así el mismo link funciona parado en /servicios
// (u otra página futura) y no solo cuando ya estás en la home.
const home = `/${lang}/`;
---
<header class="nav" data-nav>
  <nav class="nav-inner">
    <a class="nav-brand" href={home} data-magnetic>JCE</a>

    <ul class="nav-links">
      {links.map((link) => (
        <li><a href={home + link.href} data-magnetic>{link.label}</a></li>
      ))}
    </ul>

    <div class="nav-actions">
      <LangSwitch />
      <ThemeToggle />
      <!-- Popover nativo, no un menú armado a mano: top-layer, Esc y
           light-dismiss (click afuera cierra) gratis, sin una línea de JS
           propia y sin la trampa de foco que un menú custom obliga a
           resolver. Solo visible bajo el breakpoint de .nav-links (ver
           media query abajo). -->
      <button
        type="button"
        class="nav-toggle"
        popovertarget="nav-menu"
        aria-label={t("nav.menu")}
        aria-haspopup="true"
      >
        <span class="nav-toggle-bars" aria-hidden="true"></span>
      </button>
    </div>
  </nav>

  <div id="nav-menu" popover="auto" class="nav-menu">
    <ul class="nav-menu-links">
      {links.map((link) => (
        <li><a href={home + link.href}>{link.label}</a></li>
      ))}
    </ul>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    padding: 0.9rem var(--gutter);
    transition: transform 0.4s var(--ease-out-expo), background-color 0.3s ease, border-color 0.3s ease;
    border-bottom: 1px solid transparent;
  }
  .nav[data-scrolled="true"] {
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: var(--border);
  }
  .nav[data-hidden="true"] { transform: translateY(-100%); }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: var(--container);
    margin-inline: auto;
  }

  .nav-brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: none;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-links a {
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--fg-muted);
    transition: color 0.2s ease;
  }
  .nav-links a:hover { color: var(--fg); }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .nav-toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    transition: border-color 0.2s var(--ease-out-expo);
  }
  .nav-toggle:hover { border-color: var(--color-accent); }

  .nav-toggle-bars,
  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    display: block;
    width: 1.1rem;
    height: 1.5px;
    background: currentColor;
  }
  .nav-toggle-bars {
    position: relative;
  }
  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    content: "";
    position: absolute;
    left: 0;
  }
  .nav-toggle-bars::before { top: -5px; }
  .nav-toggle-bars::after { top: 5px; }

  /* El panel: top-layer real (así lo da popover="auto"), animable con
     :popover-open + @starting-style sin ninguna librería de transición. */
  .nav-menu {
    position: fixed;
    inset: 0 0 auto auto;
    top: 0;
    margin: 0;
    width: min(20rem, 100vw);
    height: 100dvh;
    padding: 5.5rem 1.5rem 2rem;
    border: none;
    border-left: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg);
    transform: translateX(100%);
    transition: transform 0.35s var(--ease-out-expo), overlay 0.35s allow-discrete, display 0.35s allow-discrete;
  }
  .nav-menu:popover-open {
    transform: translateX(0);
  }
  @starting-style {
    .nav-menu:popover-open {
      transform: translateX(100%);
    }
  }
  .nav-menu::backdrop {
    background: color-mix(in srgb, var(--color-ink) 55%, transparent);
    transition: opacity 0.35s ease, overlay 0.35s allow-discrete, display 0.35s allow-discrete;
    opacity: 0;
  }
  .nav-menu:popover-open::backdrop {
    opacity: 1;
  }
  @starting-style {
    .nav-menu:popover-open::backdrop {
      opacity: 0;
    }
  }

  .nav-menu-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .nav-menu-links a {
    display: block;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--fg);
    font-size: 1.4rem;
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }

  @media (min-width: 860px) {
    .nav-links { display: flex; }
    .nav-toggle { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-menu, .nav-menu::backdrop { transition: none; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  if (nav && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      nav.dataset.scrolled = String(y > 8);
      // Solo esconder al bajar pasado el propio alto del nav, y siempre
      // mostrar de nuevo al subir — evita el parpadeo típico cerca del tope.
      if (y > lastY && y > nav.offsetHeight) {
        nav.dataset.hidden = "true";
      } else {
        nav.dataset.hidden = "false";
      }
      lastY = y;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
  } else if (nav) {
    nav.dataset.scrolled = String(window.scrollY > 8);
  }

  // popovertarget/popovertargetaction solo son invocadores válidos en
  // <button> (y <input type="button">), no en <a> -- así que un link del
  // menú no cierra el popover solo. Sin esto, el panel queda tapando la
  // sección a la que se acaba de navegar.
  const menu = document.getElementById("nav-menu") as (HTMLElement & { hidePopover?: () => void }) | null;
  menu?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => menu.hidePopover?.());
  });
</script>
