---
import HeroCanvas from "./HeroCanvas.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section class="hero">
  <HeroCanvas />

  <div class="hero-content">
    <p class="hero-eyebrow" data-reveal>{t("hero.eyebrow")}</p>

    <h1 class="hero-title">
      <span class="hero-line" data-reveal>{t("hero.line1")}</span>
      <span class="hero-line" data-reveal>{t("hero.line2")}</span>
      <span class="hero-line hero-line-accent font-editorial" data-reveal>{t("hero.line3")}</span>
    </h1>

    <p class="hero-sub" data-reveal>{t("hero.sub")}</p>

    <div class="hero-cta" data-reveal>
      <a class="btn btn-primary" href="#services" data-magnetic>{t("hero.cta")}</a>
      <a class="btn btn-ghost" href="#contact" data-magnetic>{t("hero.ctaSecondary")}</a>
    </div>
  </div>

  <div class="hero-rail" data-reveal>
    <span class="hero-availability">{t("hero.availability")}</span>
    <a class="hero-scroll" href="#services" aria-label={t("hero.scroll")}>
      <span data-motion="ambient"></span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(6rem, 14vh, 10rem) var(--gutter) 4rem;
  }

  .hero-content {
    max-width: 64rem;
  }

  .hero-eyebrow {
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: var(--text-display);
    margin: 0;
  }

  .hero-line { display: block; }
  /* Titular de familia mixta: sans para las dos primeras líneas, serif
     itálica (.font-editorial) para la tercera -- el contraste tipográfico es
     el movimiento más fuerte de la página, y no depende de ninguna imagen. */
  .hero-line-accent { color: var(--color-accent); }

  .hero-sub {
    max-width: 34rem;
    margin-top: 2rem;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: var(--fg-muted);
    line-height: 1.6;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .hero-rail {
    position: absolute;
    inset-inline: var(--gutter);
    bottom: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .hero-availability {
    font-size: 0.8rem;
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }

  .hero-scroll {
    width: 1.5rem;
    height: 2.5rem;
    border: 1.5px solid var(--border);
    border-radius: 999px;
    display: grid;
    place-items: start center;
    padding-top: 0.4rem;
    flex-shrink: 0;
  }
  .hero-scroll span {
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--color-accent);
    animation: scroll-dot 1.8s ease-in-out infinite;
  }

  @keyframes scroll-dot {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(0.6rem); opacity: 0.3; }
  }

  @media (max-width: 560px) {
    .hero-availability { display: none; }
    .hero-rail { justify-content: flex-end; }
  }
</style>
