---
import { experience } from "../data/experience";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<div class="timeline" data-reveal>
  <h3 class="timeline-title">{t("experience.title")}</h3>
  <ol>
    {experience.map((entry) => (
      <li>
        <div class="timeline-dates">
          <span>{entry.from}</span>
          <span>—</span>
          <span>{entry.to ?? t("experience.present")}</span>
        </div>
        <div class="timeline-content">
          <p class="timeline-role">{entry.role[lang]}</p>
          <p class="timeline-org">
            {entry.org}
            {entry.orgDetail && <span class="timeline-org-detail"> — {entry.orgDetail}</span>}
          </p>
          <ul class="timeline-bullets">
            {entry.bullets[lang].map((bullet) => <li>{bullet}</li>)}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</div>

<style>
  .timeline-title {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
    margin-bottom: 1.5rem;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
  }
  li:last-child { border-bottom: none; padding-bottom: 0; }

  /* min-width:0 en el ítem de grid: sin esto, un <p>/<ul> con una palabra
     larga (una URL, "Cost-to-Serve") empuja la columna en vez de envolver --
     el default de un grid item es min-width:auto, que respeta el ancho del
     contenido antes que el de la pista. */
  .timeline-content { min-width: 0; }

  .timeline-dates {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.8rem;
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }

  .timeline-role {
    font-weight: 600;
    margin: 0;
  }
  .timeline-org {
    color: var(--fg-muted);
    font-size: 0.9rem;
    margin: 0.15rem 0 0.6rem;
    overflow-wrap: break-word;
  }
  .timeline-org-detail {
    display: inline-block;
  }
  .timeline-bullets {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--fg-muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  /* Columna de fecha fija de 120px + el resto: a 375px, con el padding de
     .section, quedaban ~200px para "Software Developer — Django REST
     Framework (Python)". Abajo de 640px la fecha pasa a eyebrow arriba del
     rol, en vez de columna angosta al costado. */
  @media (max-width: 640px) {
    li {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
    .timeline-dates {
      flex-direction: row;
      gap: 0.4rem;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
  }
</style>
