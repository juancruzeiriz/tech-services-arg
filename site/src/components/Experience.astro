---
import { experience } from "../data/experience";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<div class="timeline" data-reveal>
  <h3 class="timeline-title">{t("experience.title")}</h3>
  <ol>
    {experience.map((entry) => (
      <li>
        <div class="timeline-dates">
          <span>{entry.from}</span>
          <span>—</span>
          <span>{entry.to ?? t("experience.present")}</span>
        </div>
        <div>
          <p class="timeline-role">{entry.role[lang]}</p>
          <p class="timeline-org">{entry.org}</p>
          <ul class="timeline-bullets">
            {entry.bullets[lang].map((bullet) => <li>{bullet}</li>)}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</div>

<style>
  .timeline-title {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
    margin-bottom: 1.5rem;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
  }
  li:last-child { border-bottom: none; padding-bottom: 0; }

  .timeline-dates {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.8rem;
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }

  .timeline-role {
    font-weight: 600;
    margin: 0;
  }
  .timeline-org {
    color: var(--fg-muted);
    font-size: 0.9rem;
    margin: 0.15rem 0 0.6rem;
  }
  .timeline-bullets {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--fg-muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }
</style>
