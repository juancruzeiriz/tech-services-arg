---
import { services } from "../data/services";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { splitWords } from "../utils/text";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const servicesHref = `/${lang}/${lang === "es" ? "servicios" : "services"}/`;
---
<section class="section" id="services">
  <div class="section-inner">
    <header class="section-head">
      <h2 data-reveal>
        {splitWords(t("services.title")).map((word, i, arr) => (
          <>
            <span class="word-mask"><span class="word" style={`--i:${i}`}>{word}</span></span>
            {i < arr.length - 1 ? " " : ""}
          </>
        ))}
      </h2>
      <p class="section-lead" data-reveal>{t("services.lead")}</p>
    </header>

    <ul class="services-list">
      {services.map((service) => (
        <li data-reveal>
          <h3>{service.title[lang]}</h3>
          <p>{service.plain[lang]}</p>
        </li>
      ))}
    </ul>

    <a class="services-more" href={servicesHref} data-magnetic>{t("services.seeMore")} →</a>
  </div>
</section>

<style>
  .services-list {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1.5rem;
  }
  .services-list li {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
  }
  .services-list h3 {
    font-size: 1.05rem;
    margin: 0 0 0.6rem;
  }
  .services-list p {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .services-more {
    display: inline-block;
    margin-top: 2rem;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .services-more:hover { text-decoration: underline; }
</style>
