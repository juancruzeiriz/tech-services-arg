---
import { services } from "../data/services";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { splitWords } from "../utils/text";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const servicesHref = `/${lang}/${lang === "es" ? "servicios" : "services"}/`;
---
<section class="section" id="services">
  <div class="section-inner">
    <header class="section-head">
      <h2 data-reveal>
        {splitWords(t("services.title")).map((word, i, arr) => (
          <>
            <span class="word-mask"><span class="word" style={`--i:${i}`}>{word}</span></span>
            {i < arr.length - 1 ? " " : ""}
          </>
        ))}
      </h2>
      <p class="section-lead" data-reveal>{t("services.lead")}</p>
    </header>

    <!-- Filas editoriales, no tarjetas: el registro que usan thelist.design y
         Duna para listar capacidades sin necesitar una imagen por ítem. La
         descripción siempre está visible -- nada se esconde detrás de hover
         (ver el bug que se arregló en ProjectCard por hacer justo eso). -->
    <ol class="services-rows">
      {services.map((service, i) => (
        <li class="services-row" data-reveal tabindex="0" style={`--i:${i}`}>
          <span class="services-index">{String(i + 1).padStart(2, "0")}</span>
          <h3>{service.title[lang]}</h3>
          <p>{service.plain[lang]}</p>
        </li>
      ))}
    </ol>

    <a class="services-more" href={servicesHref} data-magnetic>{t("services.seeMore")} →</a>
  </div>
</section>

<style>
  .services-rows {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
  }
  .services-row {
    display: grid;
    grid-template-columns: 3rem 14rem 1fr;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--border);
    transition: border-color 0.3s var(--ease-out-expo);
  }
  .services-rows li:last-child { border-bottom: 1px solid var(--border); }
  .services-row:hover,
  .services-row:focus-visible {
    border-color: var(--color-accent);
  }

  .services-index {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-accent);
  }
  .services-row h3 {
    font-size: 1.2rem;
    margin: 0;
  }
  .services-row p {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 34rem;
    transition: color 0.3s ease;
  }
  .services-row:hover p,
  .services-row:focus-visible p {
    color: var(--fg);
  }

  .services-more {
    display: inline-block;
    margin-top: 2rem;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .services-more:hover { text-decoration: underline; }

  @media (max-width: 720px) {
    .services-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
