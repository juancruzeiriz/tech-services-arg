---
// Antes: un shader WebGL (OGL, 46KB) dibujando una mancha que se deforma con
// sin/cos. Ahora: el mismo efecto visual con 3 blobs radiales animados por
// CSS -- mismo resultado percibido, cero JS, cero requests, y se pausa solo
// (los navegadores ya dejan de pintar animaciones fuera de viewport).
//
// Cada blob es dos capas: el wrapper (.hero-blob) lleva la animación de
// flotación por keyframes; adentro, .hero-blob-inner recibe un transform
// distinto puesto por hero-parallax.ts (el offset del mouse, con lerp). Dos
// elementos porque una sola capa no puede tener dos transforms
// independientes -- el de JS pisaría al de la animación CSS en cada frame.
---
<div class="hero-canvas-wrap" aria-hidden="true">
  <div class="hero-blob hero-blob--a" data-motion="ambient">
    <div class="hero-blob-inner" data-blob></div>
  </div>
  <div class="hero-blob hero-blob--b" data-motion="ambient">
    <div class="hero-blob-inner" data-blob></div>
  </div>
  <div class="hero-blob hero-blob--c" data-motion="ambient">
    <div class="hero-blob-inner" data-blob></div>
  </div>
</div>

<style>
  .hero-canvas-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: -1;
    background: var(--bg);
  }

  .hero-blob {
    position: absolute;
    width: 48vmax;
    height: 48vmax;
    will-change: transform;
    /* 13s en vez de 22s, y el keyframe de abajo recorre bastante más
       distancia -- a 22s/6vw el movimiento existe pero es imperceptible en
       la ventana de atención real de un visitante (unos pocos segundos). */
    animation: blob-float 13s ease-in-out infinite;
  }
  .hero-blob-inner {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 55%, transparent),
      transparent 70%
    );
    filter: blur(70px);
    opacity: 0.7;
    will-change: transform;
    /* Suaviza el salto entre frames de hero-parallax.ts (que setea el
       transform a mano, sin su propio lerp de CSS) -- sin esto el offset
       del mouse se ve escalonado en vez de fluido. */
    transition: transform 0.4s linear;
  }
  .hero-blob--a {
    top: -10%;
    left: 20%;
  }
  .hero-blob--b {
    top: 30%;
    left: -15%;
    width: 36vmax;
    height: 36vmax;
    animation-duration: 16s;
    animation-delay: -5s;
  }
  .hero-blob--b .hero-blob-inner { opacity: 0.45; }
  /* El giro pedido: el blob del medio se tiñe de salvia en vez de naranja,
     pero SOLO en el tema oscuro -- claro y cream ya tienen su propia
     identidad resuelta y no la necesitan. :global() porque :root vive fuera
     del árbol de este componente. */
  :global(:root:not(.theme-light):not(.theme-cream)) .hero-blob--b .hero-blob-inner {
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent-alt) 55%, transparent),
      transparent 70%
    );
  }
  .hero-blob--c {
    top: 10%;
    right: -20%;
    width: 40vmax;
    height: 40vmax;
    animation-duration: 14.5s;
    animation-delay: -9s;
    animation-direction: reverse;
  }
  .hero-blob--c .hero-blob-inner { opacity: 0.35; }

  @keyframes blob-float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(11vw, -9vh) scale(1.22); }
    66% { transform: translate(-9vw, 10vh) scale(0.85); }
  }
</style>
